*unknown*, 1: > 0 string/Wc,=ABC\t\001x,"strings and flags"]
*unknown*, 2: >> 3 ubyte&000000f0,>16,", masked %d"]
*unknown*, 3: >> 4(lelong,+2), belong&,=-5,"indirect add"]
*unknown*, 4: >> 8(leshort,*4), leshort&,!0,", indirect multiply"]
*unknown*, 5: >> 2(byte,-1), byte&,x,"relative indirect"]
*unknown*, 6: >> 4 ulelong&,=4660,"from the end"]
*unknown*, 7: > 0 search/c/32,=needle,"search with range"]
*unknown*, 8: > 0 regex/l/2,^[a-z]+$,"regex with line count"]
*unknown*, 9: > 0 pstring/HJ,=pas\000\000,"pascal"]
*unknown*, 10: > 0 lestring16,=ab,"utf16"]
*unknown*, 11: > 0 date&,=Thu Jan  1 00:00:00 1970,,"a date %s"]
*unknown*, 12: > 0 qldate&,=Sun Sep  9 01:46:40 2001,,"a local qdate %s"]
*unknown*, 13: > 0 lefloat&,=1.5,"a float %g"]
*unknown*, 14: > 0 bedouble&,=-2.25E+10,"a double %g"]
*unknown*, 15: > 0 leqwdate&,=Mon Jan  1 00:00:00 1601,,"a filetime %s"]
*unknown*, 16: > 0 lemsdosdate&,=Jan 01 2017,,"a dos date %s"]
*unknown*, 17: > 0 lemsdostime&,=12:00:00,,"a dos time %s"]
*unknown*, 18: > 0 octal,=493,"an octal %s"]
*unknown*, 19: > 0 guid&,=12345678-1234-5678-9ABC-DEF012345678,"a guid"]
*unknown*, 20: > 0 quad&,=-1,"a quad %lld"]
m/rules, 21: > 0 name,='sub',""]
*unknown*, 22: >> 0 byte&,=1,"in sub"]
m/rules, 23: > 0 string,=USE,""]
m/rules, 24: >> 0 use,='sub',""]
m/rules, 25: >> 0 use,^'sub',""]
*unknown*, 26: > 0 der&,='seq',"a der"]
*unknown*, 27: > 0 default&,x,"default line"]
m/rules, 28: >> 0 clear&,x,""]
*unknown*, 29: > 0 string/,=trim,"trimmed"]
